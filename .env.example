# Copy this file to ".env" (same folder) and fill in your values.
# NEVER commit ".env": it is listed in .gitignore.

# Your Deezer "arl" cookie (see README, step 2). Gives full access to your account: keep it secret.
DEEZER_ARL=

# Family offer: name (or id) of the profile whose plays you want, e.g. TBTC.
# Leave empty to use the main profile. "python -m scripts.diagnose_deezer" lists the profiles.
DEEZER_PROFILE=

# Local database (default). In the cloud: your Neon connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///data/deezer_stats.db

# Password of the "Corrections (admin)" page.
ADMIN_PASSWORD=

# Display timezone (timestamps are stored in UTC).
TIMEZONE=Europe/Zurich

# Optional: contact shown to MusicBrainz in the User-Agent (email or URL).
MUSICBRAINZ_CONTACT=

# Optional, page « Depuis Insta » (see README): the official Instagram Graph API (Business Discovery).
# IG_USER_ID: id of YOUR professional Instagram account; IG_ACCESS_TOKEN: a long-lived token (60 days). Keep it secret.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Optional, to recognise the sound of videos: an AudD API token (audd.io; 300 free requests, then paid).
AUDD_API_TOKEN=

# Optional, the genres of your artists on the map of sound (see README): free keys that make it
# complete and fast. Last.fm: https://www.last.fm/api/account/create ; Discogs: https://www.discogs.com/settings/developers
LASTFM_API_KEY=
DISCOGS_TOKEN=
